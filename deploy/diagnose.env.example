# Optional standalone CLI only. Skip this file when using the admin UI embedded worker.
# Worker-only environment. Copy outside the repository and restrict permissions.
# diagnose does not load .env automatically; systemd reads EnvironmentFile.
DIAG_LLM_URL=https://your-model-provider.example/v1/chat/completions
DIAG_LLM_MODEL=your-model-name
DIAG_LLM_API_KEY=replace-with-worker-model-key
# Optional when the service user already has gh authentication.
# Otherwise use a dedicated repository-scoped token and Git credential helper.
# GH_TOKEN=replace-with-repository-scoped-token
